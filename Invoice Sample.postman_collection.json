{
	"info": {
		"_postman_id": "c71a1dfc-18b1-410e-9fcb-429183161b7e",
		"name": "Invoice Sample",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "7861095"
	},
	"item": [
		{
			"name": "Create Invoice",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the JSON response",
							"const responseData = pm.response.json();",
							"",
							"// Capture the 'id' from the response",
							"const invoiceId = responseData.id;",
							"",
							"// Save it to a Collection Variable (recommended) or Environment Variable",
							"pm.collectionVariables.set(\"currentInvoiceId\", invoiceId);",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"customerName\": \"John Doe\",\n  \"customerEmail\": \"john.doe@example.com\",\n  \"items\": [\n    {\n      \"name\": \"Web Hosting Service\",\n      \"quantity\": 1,\n      \"priceInCents\": 4900\n    },\n    {\n      \"name\": \"Domain Registration (.com)\",\n      \"quantity\": 2,\n      \"priceInCents\": 1250\n    }\n  ]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8000/invoices",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"invoices"
					]
				}
			},
			"response": []
		},
		{
			"name": "Send Invoice",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/invoices/{{currentInvoiceId}}/send",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"invoices",
						"{{currentInvoiceId}}",
						"send"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "currentInvoiceId",
			"value": ""
		}
	]
}